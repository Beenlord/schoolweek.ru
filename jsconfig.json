{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "baseUrl": ".",
        "paths": {
            "@/*": ["resources/js/*"],
            "@css/*": ["resources/css/*"]
        }
    },
    "include": ["resources/js/**/*.js", "resources/js/**/*.vue"],
"exclude": ["node_modules", "public"]
}
